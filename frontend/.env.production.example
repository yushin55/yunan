# Copy to .env.production (production build) or .env.local (local real-Firebase test).
# Replace placeholders with Firebase Console > Project settings > Your apps > Web config.
# Public browser values only. Never include Admin SDK / service account / Gemini secrets.
VITE_FIREBASE_API_KEY=<apiKey>
VITE_FIREBASE_AUTH_DOMAIN=<authDomain>
VITE_FIREBASE_PROJECT_ID=<projectId>
VITE_FIREBASE_APP_ID=<appId>
VITE_API_BASE_URL=<backend-origin-without-trailing-slash>
VITE_USE_FIREBASE_EMULATORS=false

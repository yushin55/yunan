# Public Firebase web app settings (these end up in the browser bundle).
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-yunan.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-yunan
VITE_FIREBASE_APP_ID=demo-app
# Backend API base URL.
VITE_API_BASE_URL=http://localhost:8000
# true only with local Firebase emulators; false in production.
VITE_USE_FIREBASE_EMULATORS=true

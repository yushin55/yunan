# Public Firebase web app settings (these end up in the browser bundle).
# Real Google sign-in also requires enabling Google in Firebase Authentication.
# Setup and diagnostics: ../docs/firebase-auth.md; npm run auth:check
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-yunan.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-yunan
VITE_FIREBASE_APP_ID=demo-app
# Kakao REST API key for the browser (public: it appears in Kakao's login URL).
# Leave empty to hide the Kakao button.
VITE_KAKAO_REST_API_KEY=
# Backend API base URL.
VITE_API_BASE_URL=http://localhost:8000
# true only with local Firebase emulators; false in production.
VITE_USE_FIREBASE_EMULATORS=true

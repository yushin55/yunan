# REFERENCE TEMPLATE ONLY: backend/.env.production is NOT automatically loaded.
# Local use: copy to backend/.env. Cloud use: enter names/values in backend secret settings.
FIREBASE_PROJECT_ID=<projectId>
# Choose ONE credential method. Both blank is valid only when the host supplies ADC.
# Method A: Base64 of service account JSON, stored as a backend-only secret.
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=
# Method B: absolute path to an externally stored or securely mounted JSON file (ADC).
GOOGLE_APPLICATION_CREDENTIALS=
ALLOWED_ORIGINS=<frontend-origin-without-trailing-slash>
ENVIRONMENT=production
# Student deployment: no external AI. Every non-blocked message waits for teacher approval.
# This is planned review, not an AI outage. Production/rules remains prohibited.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
MODERATION_MODE=teacher_review
# NEVER set FIRESTORE_EMULATOR_HOST or FIREBASE_AUTH_EMULATOR_HOST for real Firebase.

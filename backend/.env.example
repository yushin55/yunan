# Firebase project. Local development uses the demo-yunan emulator project.
FIREBASE_PROJECT_ID=demo-yunan
# Server-only service account JSON, Base64-encoded. Leave empty for the emulator.
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=
# Emulator hosts: local development only. Never set these in production.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# Frontend origins allowed to call the API (comma-separated).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# development | production
ENVIRONMENT=development
# Server-only AI key for pre-publication moderation. Never put it in a VITE_ variable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# ai: rules + AI, teacher review when AI is unavailable (default, required in production)
# rules: rules only, for local testing without an AI key
MODERATION_MODE=rules

{
  "name": "yunan-game",
  "private": true,
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "emulators": "firebase emulators:start --project demo-yunan --only auth,firestore",
    "test:rules": "node --test tests/firestore.rules.test.mjs",
    "test:ui": "node tests/ui-smoke.mjs",
    "test:immersive": "node tests/ui-immersive.mjs",
    "test:cinematic": "node tests/ui-cinematic.mjs",
    "test:audio": "node tests/ui-audio.mjs",
    "test:briefing": "node tests/ui-briefing.mjs",
    "test:multiplayer": "node tests/ui-multiplayer.mjs",
    "content:sync": "node scripts/sync-topics.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.55.0",
    "firebase": "^12.2.0",
    "firebase-tools": "^15.31.0"
  }
}
